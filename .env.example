# Next.js (.env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Docker Compose for n8n (not a secret; the HTTP actions URL ends in .convex.site)
CONVEX_SITE_URL=

# Set these on the Convex deployment with `npx convex env set NAME value`, not here:
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL
#   ADMIN_SUBJECTS            comma-separated Clerk user IDs (user_...)
#   AUTOMATION_SECRET         openssl rand -hex 32; the same value goes in the n8n credential
#   N8N_WEBHOOK_URL           https://<your n8n>/webhook/lendloop-events
