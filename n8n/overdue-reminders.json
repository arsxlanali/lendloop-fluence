{
  "id": "LLoverdueRemind1",
  "name": "LendLoop - Overdue reminders",
  "active": false,
  "nodes": [
    {
      "id": "daily-09-00-utc",
      "name": "Daily 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "claim-request",
      "name": "Claim request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { path: \"/automation/reminders/claim\", body: \"{}\" } }];"
      }
    },
    {
      "id": "hash-claim-body",
      "name": "Hash claim body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "bodySha256",
        "encoding": "hex"
      }
    },
    {
      "id": "sign-claim-request",
      "name": "Sign claim request",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'lendloop-n8n', aud: 'lendloop-convex', exp: Math.floor(Date.now() / 1000) + 300, method: 'POST', path: $json.path, body_sha256: $json.bodySha256 }) }}",
        "options": {}
      },
      "credentials": {
        "jwtAuth": {
          "id": "LLjwtCredential1",
          "name": "LendLoop automation JWT"
        }
      }
    },
    {
      "id": "send-claim-to-convex",
      "name": "Send claim to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL.replace(/\\/$/, '') + $('Claim request').item.json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Claim request').item.json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "send-reminders-mock-",
      "name": "Send reminders (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nif (!Array.isArray(response.reminders)) throw new Error(\"Unexpected claim response\");\nconst results = [];\nfor (const r of response.reminders) {\n  try {\n    if (!r.recipient?.email) throw new Error(\"No email address on file\");\n    const subject = `Reminder: the ${r.tool.name} was due back on ${r.dueDate}`;\n    // Mock delivery: a real email/Slack node goes here with r.idempotencyKey as its idempotency key.\n    console.log(\"lendloop.reminder.mock\", {\n      key: r.idempotencyKey,\n      to: r.recipient.email.replace(/^(.).*@/, \"$1***@\"),\n      subject,\n    });\n    results.push({ loanId: r.loanId, day: r.day, status: \"sent\" });\n  } catch (error) {\n    results.push({ loanId: r.loanId, day: r.day, status: \"failed\", error: String(error.message).slice(0, 200) });\n  }\n}\nreturn [\n  {\n    json: {\n      path: \"/automation/reminders/report\",\n      body: JSON.stringify({ results }),\n      sent: results.filter((r) => r.status === \"sent\").length,\n      failed: results.filter((r) => r.status === \"failed\").length,\n    },\n  },\n];"
      }
    },
    {
      "id": "hash-report-body",
      "name": "Hash report body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "bodySha256",
        "encoding": "hex"
      }
    },
    {
      "id": "sign-report-request",
      "name": "Sign report request",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'lendloop-n8n', aud: 'lendloop-convex', exp: Math.floor(Date.now() / 1000) + 300, method: 'POST', path: $json.path, body_sha256: $json.bodySha256 }) }}",
        "options": {}
      },
      "credentials": {
        "jwtAuth": {
          "id": "LLjwtCredential1",
          "name": "LendLoop automation JWT"
        }
      }
    },
    {
      "id": "send-report-to-convex",
      "name": "Send report to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL.replace(/\\/$/, '') + $('Send reminders (mock)').item.json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Send reminders (mock)').item.json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "more-overdue-loans-",
      "name": "More overdue loans?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.more === true && $runIndex < 49 }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "finish",
      "name": "Finish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const { more, failedToday } = $input.first().json;\n// Failed reminders are recorded in Convex (and shown on each loan). Failing the execution\n// as well hands it to the error workflow, so an admin sees it in the app.\nif (more) throw new Error(\"Stopped after 50 batches with overdue loans left; run again to continue\");\nif (failedToday > 0) throw new Error(`${failedToday} reminder(s) failed today; see the admin page`);\nreturn [{ json: { failedToday } }];"
      }
    }
  ],
  "connections": {
    "Daily 09:00 UTC": {
      "main": [
        [
          {
            "node": "Claim request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim request": {
      "main": [
        [
          {
            "node": "Hash claim body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hash claim body": {
      "main": [
        [
          {
            "node": "Sign claim request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign claim request": {
      "main": [
        [
          {
            "node": "Send claim to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send claim to Convex": {
      "main": [
        [
          {
            "node": "Send reminders (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminders (mock)": {
      "main": [
        [
          {
            "node": "Hash report body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hash report body": {
      "main": [
        [
          {
            "node": "Sign report request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign report request": {
      "main": [
        [
          {
            "node": "Send report to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send report to Convex": {
      "main": [
        [
          {
            "node": "More overdue loans?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "More overdue loans?": {
      "main": [
        [
          {
            "node": "Claim request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Finish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true,
    "executionTimeout": 120,
    "timezone": "UTC",
    "errorWorkflow": "LLautomationErr1"
  },
  "pinData": {},
  "meta": {
    "description": "LendLoop. Notifications are logged mocks. No secrets in this file."
  }
}
